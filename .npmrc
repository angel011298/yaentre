ignore-scripts=true
# G66: `pnpm add` guarda la versión EXACTA en package.json (sin `^`/`~`).
# El propio package.json ya está pinneado a mano a lo que hoy corre probado;
# esto evita que la siguiente instalación manual la vuelva a aflojar sin
# querer. Ver docs/AUDITORIA_SEGURIDAD.md §16 — sin esto, cualquier rango
# abierto es una actualización no revisada esperando a que alguien corra
# `pnpm install` en una máquina sin el lockfile (que hasta esta fase tampoco
# se versionaba: ver el mismo punto del reporte).
save-exact=true
