// ═══════════════════════════════════════════════════════════════════
// YaEntre — schema.prisma (v1.0)
// Base: Supabase PostgreSQL · ORM: Prisma
// Migración inicial: npx prisma migrate dev --name yaentre_init
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum InstitutionCode {
  UNAM
  IPN
  UAM
  CENEVAL
  CNBV
}

enum LevelType {
  MEDIA_SUPERIOR
  SUPERIOR
}

enum SessionMode {
  DIAGNOSTIC
  TOPIC_DRILL
  AREA_PRACTICE
  FULL_SIMULATION
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  COMPLETED_BY_TIMEOUT
  ABANDONED
}

enum DifficultyLevel {
  BEGINNER
  BASIC
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum UserRole {
  STUDENT
  PARENT
  ADMIN
  // Bloque 3 — roles de personal. NO son alumnos ni tutores: no tienen onboarding
  // ni acceso a /app. Sus capacidades viven en `src/lib/admin/capabilities.ts`
  // (matriz enumerada y probada); `is_admin()` en la base sigue reconociendo SOLO
  // a ADMIN, así que ninguno de los dos puede leer nada por /rest/v1.
  ACCOUNTANT // contador: solo lectura fiscal (/fiscal)
  SUPPORT // soporte: ARCO y reembolsos (/soporte)
}

enum SubscriptionPlan {
  MONTHLY
  SEASON_PASS
  PREMIUM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
  CANCELED
}

enum PricingSeason {
  EARLY_BIRD
  HIGH_SEASON
  LAST_MINUTE
}

enum PaymentMethod {
  CARD
  OXXO
  SPEI
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ContentType {
  VIDEO_LECTURE
  LIVESTREAM
  PROFESSOR_NOTE
  PDF_MATERIAL
  PRACTICE_SET
}

enum ContentStatus {
  INACTIVE
  DRAFT
  ACTIVE
}

enum NotificationType {
  STREAK_RISK
  PARENT_WEEKLY
  EXAM_COUNTDOWN
  MARKETING
}

enum QuestionSource {
  GENERATED // Creado por el pipeline IA
  OFFICIAL_SAMPLE // Muestra oficial de examen (UNAM, IPN, etc.)
  IMPORTED // Importado de otras fuentes
}

enum QuestionUsage {
  SERVABLE // Se puede mostrar a usuarios finales
  CALIBRATION_ONLY // Solo para calibración interna, nunca servible
}

enum QuestionFormat {
  MULTIPLE_CHOICE // Pregunta directa estándar de opción múltiple (4 opciones de texto)
  READING_COMPREHENSION // Depende de un Passage compartido (comprensión de lectura)
  IMAGE_OPTIONS // Las opciones son imágenes (imageUrl por opción)
  CHART_TABLE // El enunciado incluye una gráfica/tabla como estímulo
  MATCHING // Relacionar columnas (concepto ↔ descripción)
  SENTENCE_COMPLETION // Completar la oración / frase con la opción correcta
  ANALOGY // Analogías verbales (A es a B como C es a ...)
  ORDERING // Ordenamiento de elementos (cronológico, lógico, sintáctico)
  NUMERIC_SERIES // Series numéricas (sucesiones; hallar el siguiente término)
  PROBLEM_SOLVING // Resolución de problemas con cálculo (mat/fís/quím aplicadas)
  SPATIAL_SERIES // Series espaciales (secuencias de figuras)
  SPATIAL_IMAGINATION // Imaginación espacial (rotación, plegado, perspectiva)
}

enum ConfidenceLevel {
  HIGH // Fuente oficial primaria (transparencia/resultados), dato verificado
  MED // ≥2 fuentes independientes coinciden (±2), sin fuente oficial primaria confirmada
  LOW // Fuentes divergen (>±2) o solo hay una fuente débil — se usa el valor más conservador
}

enum GroundingStatus {
  SOURCED // El reactivo cita ≥1 SourceChunk real (trazabilidad en QuestionSourceChunk)
  TEMARIO_ONLY // Generado solo con el temario oficial (sin fragmento fuente disponible)
}

// ──────────────────── TAXONOMÍA DE CONTENIDO ────────────────────

model Institution {
  id        String          @id @default(cuid())
  code      InstitutionCode @unique
  name      String
  logoUrl   String?
  levels    Level[]
  createdAt DateTime        @default(now())

  @@map("institutions")
}

model ContentSource {
  id          String        @id @default(cuid())
  name        String // "Guía UNAM 2025", "IPN Simulacro Oficial", etc.
  institution String? // Institución asociada (UNAM, IPN, etc.)
  type        String? // "MEDIA_SUPERIOR" / "SUPERIOR"
  year        Int? // Año de publicación
  fileRef     String? // Dónde vive el PDF: URL pública oficial (https://..., embebible/enlazable
  // directo, ver CC-25) o path local aún no publicado (docs/guias/..., no servible)
  license     String? // Descripción de licencia
  externalRef String?       @unique // Clave estable para idempotencia de ingesta (p. ej. "ECOEMS-2025")
  contentHash String?       @unique // SHA-256 del archivo (F2b): detección de nuevos/modificados por contenido
  ingestedAt  DateTime      @default(now())
  questions   Question[]    @relation("QuestionSource")
  passages    Passage[]     @relation("PassageSource")
  chunks      SourceChunk[]

  @@map("content_sources")
}

// Fragmento REAL de un documento fuente (F2b). Ancla la generación: cada
// reactivo SOURCED cita ≥1 chunk vía QuestionSourceChunk. NUNCA servible a
// usuarios finales (RLS: solo ADMIN; el pipeline escribe con service role).
model SourceChunk {
  id              String                @id @default(cuid())
  contentSourceId String
  contentSource   ContentSource         @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  topicId         String? // Tema del temario al que corresponde (null = sin clasificar o fuera de temario)
  topic           Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subjectId       String? // Materia (para chunks clasificables a materia pero no a tema puntual)
  subject         Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  text            String                @db.Text // Fragmento completo (contexto de generación)
  excerpt         String // Cita breve para UI/admin (primeras ~200 chars limpias)
  locationRef     String? // Página/sección de origen (p. ej. "p. 34", "§2.3")
  classifiedAt    DateTime? // null = clasificación pendiente; set + topicId null = fuera de temario
  createdAt       DateTime              @default(now())
  questions       QuestionSourceChunk[]

  @@index([topicId])
  @@index([contentSourceId])
  @@index([classifiedAt])
  @@map("source_chunks")
}

// Trazabilidad muchos-a-muchos reactivo ↔ fragmento fuente (F2b).
model QuestionSourceChunk {
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceChunkId String
  sourceChunk   SourceChunk @relation(fields: [sourceChunkId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([questionId, sourceChunkId])
  @@map("question_source_chunks")
}

model Passage {
  id              String         @id @default(cuid())
  title           String?
  content         String         @db.Text
  sourceRef       String? // Cita del texto (autor, obra)
  contentSourceId String?
  contentSource   ContentSource? @relation("PassageSource", fields: [contentSourceId], references: [id], onDelete: SetNull)
  questions       Question[]
  createdAt       DateTime       @default(now())

  @@map("passages")
}

model Level {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  type          LevelType
  name          String
  exams         Exam[]

  @@unique([institutionId, type])
  @@map("levels")
}

model Exam {
  id             String        @id @default(cuid())
  levelId        String
  level          Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  year           Int
  name           String
  durationMins   Int // UNAM: 180, IPN: ~180
  totalQuestions Int // UNAM: 120, IPN: 140
  examDate       DateTime? // fecha oficial del examen (para countdown/vigencia)
  isActive       Boolean       @default(true)
  areas          Area[]
  sessions       ExamSession[]
  profiles       UserProfile[] @relation("TargetExam")

  @@unique([levelId, year])
  @@map("exams")
}

model Area {
  id        String    @id @default(cuid())
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  code      String // "AREA_1", "IPN_FISMAT"...
  name      String
  colorHex  String
  iconEmoji String?
  position  Int
  subjects  Subject[]
  careers   Career[]

  @@unique([examId, code])
  @@map("areas")
}

model Career {
  id                    String           @id @default(cuid())
  areaId                String
  area                  Area             @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name                  String
  minAciertos           Int? // aciertos mínimos históricos de ingreso (arranque en frío del Entrómetro)
  minAciertosYear       Int?
  minAciertosConfidence ConfidenceLevel? // HIGH/MED/LOW — ver CC-13: triangulación multi-fuente
  sources               Json? // [{ url, label, retrievedAt }] — evidencia citable del dato
  acceptanceRate        Float?
  targetedBy            UserProfile[]    @relation("TargetCareer")

  @@unique([areaId, name])
  @@map("careers")
}

model Subject {
  id             String  @id @default(cuid())
  areaId         String
  area           Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name           String
  iconEmoji      String?
  position       Int
  questionWeight Int     @default(1) // # reactivos esperados en el examen real

  // ── Reutilización de contenido entre áreas (G26) ──
  // Varias áreas del MISMO examen evalúan esta materia con el mismo temario
  // oficial (UNAM: Español/Inglés/Química en varias áreas; IPN: Español,
  // Inglés, Química y Matemáticas en varias ramas) — solo cambia
  // questionWeight, no QUÉ se evalúa. Cuando ≥2 filas Subject del mismo examen
  // comparten esta clave (no nula), sus reactivos verificados y servibles
  // forman UN solo pool: un reactivo bajo cualquiera de ellas es elegible para
  // un alumno que apunta a cualquiera de esas áreas. La equivalencia se
  // declara en el seed (taxonomía = data, principio S2). NUNCA cruza
  // instituciones (guías, profundidad y formato distintos).
  sharedContentKey String?

  topics       Topic[]
  contentItems ContentItem[]
  sourceChunks SourceChunk[]

  @@unique([areaId, name])
  @@index([sharedContentKey])
  @@map("subjects")
}

model Topic {
  id           String        @id @default(cuid())
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  questions    Question[]
  weakTopics   WeakTopic[]
  contentItems ContentItem[]
  sourceChunks SourceChunk[]

  @@unique([subjectId, name])
  @@map("topics")
}

model Question {
  id         String          @id @default(cuid())
  topicId    String
  topic      Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  stem       String          @db.Text
  imageUrl   String?
  options    Json // [{ id:"A", text, isCorrect }, ...]
  difficulty DifficultyLevel @default(INTERMEDIATE)
  sourceYear Int?
  isVerified Boolean         @default(false)

  // ── Procedencia y uso del contenido (CC-01c) ──
  source          QuestionSource @default(GENERATED) // De dónde viene el reactivo
  usage           QuestionUsage  @default(SERVABLE) // Puede servirse a usuarios
  sourceRef       String? // Cita/referencia de la fuente
  contentSourceId String?
  contentSource   ContentSource? @relation("QuestionSource", fields: [contentSourceId], references: [id])

  // ── Formato y estímulo compartido (CC-01b / CC-09) ──
  format      QuestionFormat @default(MULTIPLE_CHOICE)
  passageId   String?
  passage     Passage?       @relation(fields: [passageId], references: [id], onDelete: SetNull)
  externalRef String?        @unique // Idempotencia de ingesta (p. ej. "ECOEMS-2025#Q29")

  // ── Verificación adversarial (F2) ──
  // Veredicto completo del pipeline: respuesta del verificador, confianza,
  // problemas detectados, decisión, tercera pasada de auditoría si aplica.
  // Un reactivo GENERATED solo pasa a isVerified=true vía este pipeline
  // (dos modelos independientes coinciden). Sin resolver → queda sin publicar.
  verification Json?

  // ── Anclaje en documentos fuente (F2b) ──
  // SOURCED = cita ≥1 SourceChunk real (relación en QuestionSourceChunk).
  // TEMARIO_ONLY = generado solo con el temario (transparente, no bloqueante).
  groundingStatus GroundingStatus       @default(TEMARIO_ONLY)
  sourceChunks    QuestionSourceChunk[]

  explanations ExplanationLayer[]
  answers      SessionAnswer[]
  reports      QuestionReport[]

  // ── Fase 2 (nullable, INACTIVE en Fase 1) ──
  videoLectureId  String?
  videoLecture    ContentItem? @relation("QuestionVideo", fields: [videoLectureId], references: [id])
  professorNoteId String?
  professorNote   ContentItem? @relation("QuestionNote", fields: [professorNoteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, isVerified])
  @@index([difficulty])
  @@index([usage])
  @@map("questions")
}

model ExplanationLayer {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  layer        Int // 1..4
  title        String
  content      String   @db.Text
  latexContent String?

  @@unique([questionId, layer])
  @@map("explanation_layers")
}

model QuestionReport {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedBy String // userId
  reason     String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([questionId, resolved])
  @@map("question_reports")
}

// ──────────────── CONTENIDO FASE 2 (INACTIVO) ────────────────

model ContentItem {
  id              String        @id @default(cuid())
  type            ContentType
  status          ContentStatus @default(INACTIVE) // ← NUNCA ACTIVE en Fase 1
  title           String?
  url             String?
  thumbnailUrl    String?
  durationSeconds Int?
  scheduledAt     DateTime?

  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  topicId     String?
  topic       Topic?     @relation(fields: [topicId], references: [id])
  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id])

  questionsVideo Question[] @relation("QuestionVideo")
  questionsNote  Question[] @relation("QuestionNote")

  createdAt DateTime @default(now())

  @@map("content_items")
}

model Professor {
  id          String        @id @default(cuid())
  name        String
  bio         String?
  avatarUrl   String?
  subjectTags String[]
  content     ContentItem[]

  @@map("professors")
}

// ──────────────── USUARIO Y APRENDIZAJE ────────────────

model UserProfile {
  id     String   @id @default(cuid())
  userId String   @unique // Supabase Auth UID
  role   UserRole @default(STUDENT)

  displayName String?
  avatarUrl   String?
  themePref   String   @default("dark") // "dark" | "light"
  badges      String[] @default([]) // ["EARLY_BIRD", ...]

  // ── Protección de menores + datos personales (Bloque 1, handoff §3.1) ──
  // Fecha de nacimiento DECLARADA en el registro (modelo por capas de menores):
  //   · < 15 años → registro bloqueado (no se crea la cuenta);
  //   · < 18 años → antes de PAGAR se exige confirmación del tutor por liga
  //     (ver `TutorConsent`).
  // `birthDateDeclaredAt` es la evidencia de CUÁNDO se hizo la declaración.
  // Nulable: las cuentas creadas antes de Bloque 1 no la traen y el checkout
  // exige completarla antes de comprar.
  birthDate           DateTime?
  birthDateDeclaredAt DateTime?

  // Atribución de marketing (F24): parámetros de campaña de la PRIMERA visita
  // (utm_source/medium/campaign/content/term, fbclid/ttclid/gclid, landingPath,
  // capturedAt) — capturados en `proxy.ts` a una cookie de 90 días, persistidos
  // aquí SOLO al crear el perfil (nunca se sobreescribe) para poder atribuir
  // cualquier compra futura al canal que originó el registro. `null` si el
  // usuario llegó sin ningún parámetro de campaña (tráfico directo/orgánico).
  acquisitionSource Json?

  // Examen objetivo
  targetExamId   String?
  targetExam     Exam?   @relation("TargetExam", fields: [targetExamId], references: [id])
  targetCareerId String?
  targetCareer   Career? @relation("TargetCareer", fields: [targetCareerId], references: [id])

  // Onboarding
  diagnosticDone Boolean @default(false)
  onboardingStep Int     @default(0)

  // Relaciones de aprendizaje
  learningProfile LearningProfile?
  streak          StreakRecord?
  weakTopics      WeakTopic[]
  sessions        ExamSession[]

  // Comercial
  subscriptions Subscription[]

  // Preferencias
  notificationPrefs NotificationPreference[]

  // Vinculación parental (dos lados)
  asParentLinks  ParentLink[]     @relation("ParentSide")
  asStudentLinks ParentLink[]     @relation("StudentSide")
  linkCodes      ParentLinkCode[]

  // Confirmación del tutor para un alumno menor de 18 (Bloque 1)
  tutorConsent TutorConsent?

  // Marketplace de profesores (Bloque 2). Una cuenta puede ser a la vez alumno
  // y profesor: ser profesor NO es un rol (`UserRole`), es la existencia de una
  // fila `Teacher`. Ninguna de las dos relaciones tiene `onDelete: Cascade`:
  // las clases y las liquidaciones son registros fiscales (retención de 5 años,
  // art. 30 CFF) y no pueden desaparecer con la cuenta — el borrado de cuenta
  // ANONIMIZA el perfil, no lo elimina (src/lib/db/account.ts).
  teacher        Teacher?       @relation("TeacherProfile")
  studentClasses ClassSession[] @relation("StudentClasses")

  // Administración (G99). Ambas con SetNull, nunca Cascade: ni la bitácora ni
  // la bóveda pueden desaparecer porque se elimine la cuenta del admin que
  // actuó o que subió el archivo.
  adminAuditActions AdminAuditLog[] @relation("AdminAuditActor")
  adminFiles        AdminFile[]     @relation("AdminFileUploader")
  adminNotes        AdminNote[]     @relation("AdminNoteAuthor")

  // Programa de referidos (Bloque 3, ESPECIFICACION_QR_COMISIONES §3). Nivel 1:
  // el crédito no es efectivo, así que ninguna de estas filas es un pago.
  //   · `referredByCodeId`: a QUÉ código de referido se debe el registro. Se
  //     escribe SOLO al crear el perfil (first-touch wins: nunca se
  //     sobreescribe) y se pone en NULL al eliminar el código, no al revés.
  //   · `referralCode`: el código PROPIO de esta persona (uno por tipo).
  //   · `referralCreditLots`/`referralRedemptions`: el libro del crédito ganado
  //     y gastado. Con Cascade: son datos de la persona y no un registro fiscal
  //     (un descuento comercial no es ingreso). El borrado de cuenta ANONIMIZA
  //     el perfil, así que en la práctica nada se elimina en cascada.
  referredByCodeId    String?
  referredByCode      ReferralCode?              @relation("ReferredByCode", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  referralCodes       ReferralCode[]             @relation("ReferralCodeOwner")
  referralCreditLots  ReferralCreditLot[]        @relation("ReferralCreditOwner")
  referralRedemptions ReferralCreditRedemption[] @relation("ReferralCreditRedeemer")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([referredByCodeId])
  @@map("user_profiles")
}

model LearningProfile {
  userProfileId  String      @id
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  predictedScore Int?
  lastPredicted  DateTime?
  confidence     Float?
  totalQuestions Int         @default(0)
  correctAnswers Int         @default(0)
  totalStudyMins Int         @default(0)
  updatedAt      DateTime    @updatedAt

  @@map("learning_profiles")
}

model WeakTopic {
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  hitRate       Float
  attempts      Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@id([userProfileId, topicId])
  @@index([userProfileId, hitRate])
  @@map("weak_topics")
}

model StreakRecord {
  userProfileId    String      @id
  userProfile      UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  currentStreak    Int         @default(0)
  longestStreak    Int         @default(0)
  lastActivityDate DateTime?
  totalActiveDays  Int         @default(0)

  @@index([lastActivityDate])
  @@map("streak_records")
}

// ──────────────── SESIONES DE EXAMEN ────────────────

model ExamSession {
  id            String        @id @default(cuid())
  userProfileId String
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam          @relation(fields: [examId], references: [id])
  mode          SessionMode
  status        SessionStatus @default(IN_PROGRESS)

  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  timeLimitSecs Int

  score      Int?
  percentile Float?

  // Integridad del simulador
  tabBlurCount             Int     @default(0)
  rightClickAttempts       Int     @default(0)
  keyboardShortcutAttempts Int     @default(0)
  suspicionEvents          Json?
  completedFullscreen      Boolean @default(false)

  answers SessionAnswer[]

  @@index([userProfileId, mode])
  @@index([userProfileId, status])
  @@map("exam_sessions")
}

model SessionAnswer {
  id             String      @id @default(cuid())
  sessionId      String
  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption String? // "A".."D" | null (omitida)
  isCorrect      Boolean
  timeSpentSecs  Int
  position       Int

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("session_answers")
}

// ──────────────── COMERCIAL (PAGOS) ────────────────

model Subscription {
  id            String             @id @default(cuid())
  userProfileId String
  userProfile   UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan
  status        SubscriptionStatus @default(PENDING)
  season        PricingSeason
  hasGuarantee  Boolean            @default(false) // true para PREMIUM

  // G99 — cortesía otorgada desde el panel de administración, no una venta.
  // Para el paywall es INDISTINGUIBLE de una compra (mismo status, mismo
  // expiresAt, misma insignia); solo el contador de licencias Early Bird la
  // excluye, porque una licencia regalada no puede descontar del «quedan X
  // de 500» que se anuncia en vivo. Una cortesía nunca crea `Payment`.
  isComp Boolean @default(false)

  // ── Consentimiento art. 56 LFPC (Bloque 1, handoff §3.4) ──
  // Renuncia expresa al derecho de revocación por prestación inmediata. Se
  // captura en `startCheckoutAction` ANTES de crear la sesión de Stripe (es un
  // requisito para poder cobrar sin ofrecer los 10 días hábiles). Se guarda la
  // marca de tiempo Y la versión del texto aceptado (`ART56_CONSENT_VERSION` en
  // src/lib/legal/consent-texts.ts). Nulable por compatibilidad con filas
  // históricas; toda compra nueva lo escribe.
  art56ConsentAt      DateTime?
  art56ConsentVersion String?

  // Referencias Stripe
  stripeCustomerId        String?
  stripeSubscriptionId    String? // solo MONTHLY (recurring)
  stripeCheckoutSessionId String? @unique

  startedAt DateTime?
  expiresAt DateTime? // Pase/Premium: = fecha del examen

  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userProfileId, status])
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(cuid())
  subscriptionId        String
  subscription          Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountMxn             Int // en centavos
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())

  // Bloque 3 — CUÁNDO se cobró de verdad. `createdAt` es cuándo se creó la fila,
  // y para OXXO/SPEI la fila nace PENDING al generar la ficha y el dinero llega
  // días después (a veces en otro mes). La base fiscal es de EFECTIVO: el
  // tablero fiscal y el monitor RESICO cuentan por esta fecha, no por `createdAt`.
  // La escribe el webhook al pasar el pago a SUCCEEDED.
  paidAt DateTime?

  refunds PaymentRefund[]

  @@index([paidAt])
  @@map("payments")
}

/// Bloque 3 — un reembolso de un pago, con SU fecha. Una sola columna acumulada
/// («reembolsado: $X») no sirve para lo fiscal: el IVA de una devolución se
/// descuenta en el mes en que se HACE, que puede no ser el del cobro. La fila la
/// escribe el webhook (`charge.refunded`), la acción de soporte o la reconciliación
/// —las tres por `stripeRefundId` único, así que reintentar no duplica— y es lo
/// que revierte el crédito de un referido.
model PaymentRefund {
  id             String       @id @default(cuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  stripeRefundId String       @unique
  amountMxn      Int // centavos devueltos
  occurredAt     DateTime // cuándo lo registró Stripe: la fecha fiscal de la devolución
  source         RefundSource
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([paymentId])
  @@index([occurredAt])
  @@map("payment_refunds")
}

enum RefundSource {
  WEBHOOK // llegó por `charge.refunded` (p. ej. hecho desde el panel de Stripe)
  SUPPORT // lo emitió el rol de soporte desde /soporte
  RECONCILIATION // lo encontró el job diario al comparar con Stripe
}

// Idempotencia de webhooks de Stripe
model ProcessedStripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Stripe event.id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ──────────────── VINCULACIÓN PARENTAL ────────────────

model ParentLink {
  id               String      @id @default(cuid())
  parentProfileId  String
  parentProfile    UserProfile @relation("ParentSide", fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   UserProfile @relation("StudentSide", fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())

  @@unique([parentProfileId, studentProfileId])
  @@map("parent_links")
}

model ParentLinkCode {
  id               String      @id @default(cuid())
  code             String      @unique // 6 dígitos
  studentProfileId String
  studentProfile   UserProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  expiresAt        DateTime // TTL 10 min
  usedAt           DateTime?
  createdAt        DateTime    @default(now())

  @@index([code])
  @@map("parent_link_codes")
}

// ──────────────── CONFIRMACIÓN DEL TUTOR PARA MENORES (Bloque 1) ────────────────
//
// Modelo por capas de menores (handoff §3.1): un titular menor de 18 puede
// registrarse y usar el plan Free, pero ANTES DE PAGAR necesita que su tutor
// confirme por una liga. Esa confirmación sirve doble: (a) consentimiento del
// tratamiento de datos del menor (LFPDPPP), y (b) ratificación del contrato de
// adhesión, que sana la nulidad relativa por minoría de edad (arts. 646/1798/
// 2228 CCF). La misma liga recoge los consentimientos granulares de marketing,
// analítica y grabación (item 4).
//
// El token de la liga NUNCA se genera con `Math.random` (guardrail G65): se crea
// con `crypto.randomBytes` y se guarda SOLO su hash SHA-256 — la liga trae el
// token en claro y el servidor lo hashea para buscar, así que una fuga de la
// base no permite reconstruir ligas válidas. Un solo `TutorConsent` por alumno
// (`@unique`): reenviar la liga regenera el token de la misma fila.
model TutorConsent {
  id               String      @id @default(cuid())
  studentProfileId String      @unique
  studentProfile   UserProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  tutorEmail   String
  tutorName    String?
  relationship String? // parentesco declarado por el tutor al confirmar

  // Liga de un solo uso. `tokenHash` = SHA-256 del token en claro (nunca el
  // token). `tokenExpiresAt` acota la ventana de la liga.
  tokenHash      String   @unique
  tokenExpiresAt DateTime

  // Consentimientos granulares (item 4). `dataConsent` es obligatorio para
  // menores; los otros tres son opcionales. `consentVersion` sella con qué
  // versión de los textos se otorgaron (src/lib/legal/consent-texts.ts).
  dataConsent      Boolean @default(false)
  marketingConsent Boolean @default(false)
  analyticsConsent Boolean @default(false)
  recordingConsent Boolean @default(false)
  consentVersion   String?

  requestedAt DateTime  @default(now())
  confirmedAt DateTime? // set cuando el tutor confirma; null = pendiente
  confirmedIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tokenHash])
  @@map("tutor_consents")
}

// ──────────────── PREFERENCIAS DE NOTIFICACIÓN ────────────────

model NotificationPreference {
  id            String           @id @default(cuid())
  userProfileId String
  userProfile   UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          NotificationType
  enabled       Boolean          @default(true)

  @@unique([userProfileId, type])
  @@map("notification_preferences")
}

// ──────────────── ADMINISTRACIÓN (G99) ────────────────

// Bitácora persistente de acciones de administración. Sustituye al
// `console.log` con prefijo `[ADMIN_AUDIT]` de CC-06, que no dejaba historial
// consultable. La plataforma trata datos de personas de 15 a 17 años.
//
// `actor` es NULABLE con SetNull (no Cascade): una bitácora que se borra sola
// al eliminarse la cuenta del actor no es una bitácora. `actorEmail` es la
// instantánea legible que sobrevive a ese borrado.
//
// `targetUserProfileId` va SIN relación a propósito — la bitácora registra lo
// que le pasó a una cuenta aunque después se elimine (LFPDPPP).
//
// `action` es un string tipado en código (`AdminAuditAction` en
// src/lib/admin/audit-log.ts), no un enum de base: añadir una acción no debe
// exigir una migración.
model AdminAuditLog {
  id String @id @default(cuid())

  actorUserProfileId String?
  actor              UserProfile? @relation("AdminAuditActor", fields: [actorUserProfileId], references: [id], onDelete: SetNull)
  actorEmail         String?

  action              String
  targetUserProfileId String?
  targetKind          String
  reason              String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())

  @@index([actorUserProfileId, createdAt])
  @@index([targetUserProfileId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// Índice de la bóveda de archivos del administrador (G99 parte A2).
//
// El listado se sirve de esta tabla y NO de listar el bucket: el nombre
// ORIGINAL del archivo no puede vivir en el path (el path se deriva de
// `crypto.randomUUID()` + la extensión del TIPO declarado, nunca del nombre
// que mandó el cliente), y listar un bucket es una llamada de red por página.
//
// 🔒 Requisito explícito del dueño: los archivos se guardan HASTA que el admin
// maestro los elimine. De ahí `uploadedBy` con SetNull —jamás Cascade—: si la
// fila muriera al borrarse la cuenta de quien subió, el objeto quedaría
// huérfano en el bucket, fuera del listado y por tanto ni accesible ni
// borrable. `uploadedByEmail` es la instantánea legible que lo sobrevive.
// No hay TTL, ni ciclo de vida, ni job que borre nada: `deletedAt` solo lo
// escribe `deleteVaultFileAction`, que exige admin maestro.
model AdminFile {
  id           String @id @default(cuid())
  path         String @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String

  uploadedById    String?
  uploadedBy      UserProfile? @relation("AdminFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByEmail String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt, createdAt])
  @@map("admin_files")
}

// Notas del panel de administración — apartado dentro de /admin/boveda.
//
// Persistidas en Postgres a propósito: el requisito es que sean las MISMAS
// sin importar en qué dispositivo o sesión se abran, «en el momento que
// sea» — localStorage es por-navegador y no lo cumple. Cualquier ADMIN puede
// crear, ver y borrar (no se exige admin maestro: son apuntes internos de
// bajo riesgo, a diferencia de una cortesía o un cambio de rol).
//
// `authorId` con SetNull, igual que `AdminFile.uploadedBy`: la nota no
// desaparece porque se borre la cuenta de quien la escribió. `authorEmail`
// es la instantánea legible que sobrevive a ese borrado.
model AdminNote {
  id      String @id @default(cuid())
  content String @db.Text

  authorId    String?
  author      UserProfile? @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("admin_notes")
}

// ──────────────── MARKETPLACE DE PROFESORES (Bloque 2) ────────────────
//
// Fuente: ESPECIFICACION_MARKETPLACE_PROFESORES_CTO.md §2. Los ajustes respecto
// del schema de la spec están enumerados en RETORNO_BLOQUE2.md §«Ajustes al
// modelo»; los principales:
//   · `User` → `UserProfile` (este repo no tiene modelo `User`: la identidad de
//     Auth vive en Supabase y el perfil es `UserProfile`).
//   · `@@map` en snake_case (convención del repo).
//   · Campos que los flujos de la propia spec necesitan y el modelo omitía:
//     disponibilidad semanal, nombre público, reembolsos, consentimiento de
//     grabación, marcas de tiempo del ciclo de vida, y el estado
//     PENDING_PAYMENT de una clase aún no pagada.
//
// 🔒 `curp`, `clabe`, `rfc` y `phone` son datos personales/financieros. Solo
// los lee el propio profesor (por su guard) y el admin maestro (hoja de pago).
// Ningún endpoint público los selecciona — ver `PUBLIC_TEACHER_SELECT` en
// src/lib/db/teachers.ts, que tiene una prueba que lo impide.

enum TeacherPaymentRail {
  ASIMILADOS // Carril B (default) — YaEntre emite CFDI de nómina
  COMISION_MERCANTIL // Carril A (excepción) — el profesor factura
}

enum TeacherLevel {
  INICIAL // ×1.00 — automático al aprobarse el onboarding
  VERIFICADO // ×1.15 — ≥15 clases + ≥4.2★ + ≤10% cancelaciones
  DESTACADO // ×1.30 — ≥50 clases + ≥4.5★ + ≤5% cancelaciones + ≥3 meses
}

enum TeacherStatus {
  PENDING_REVIEW // Onboarding completado, pendiente de revisión admin
  ACTIVE // Aprobado, visible en el directorio
  SUSPENDED // Suspendido (fraude, incidencias)
  INACTIVE // Voluntariamente inactivo
}

enum ClassStatus {
  PENDING_PAYMENT // Reservada; el pago aún no lo confirma el webhook. Retiene el horario.
  BOOKED // Reservada y pagada por el alumno
  CONFIRMED // El profesor confirmó asistencia
  IN_PROGRESS // Clase en curso
  COMPLETED // Clase impartida
  CANCELLED // Cancelada
  NO_SHOW_TEACHER // El profesor no se presentó
  NO_SHOW_STUDENT // El alumno no se presentó
  DISPUTED // En disputa
}

enum CancelledBy {
  STUDENT
  TEACHER
  SYSTEM // Cancelación automática (no-show, pago no confirmado, sin confirmación del profesor)
}

enum PayoutStatus {
  PENDING // Calculado, pendiente de aprobación admin
  APPROVED // Aprobado, listo para transferir
  TRANSFERRED // SPEI enviado
  FAILED // Transferencia fallida
  CANCELLED // Cancelado (fraude, etc.)
}

enum RetentionStatus {
  HELD // Retenido (30 días naturales)
  RELEASED // Liberado automáticamente
  FORFEITED // Confiscado (incidencia grave)
}

model Teacher {
  id            String      @id @default(cuid())
  userProfileId String      @unique
  userProfile   UserProfile @relation("TeacherProfile", fields: [userProfileId], references: [id])

  // Datos de onboarding
  fullName   String
  // Cómo aparece ante el alumno («Juan P.»). Lo elige el profesor: derivarlo del
  // nombre completo falla con nombres compuestos («María Guadalupe Pérez»).
  publicName String
  bio        String?
  rfc        String? // Opcional — solo el Carril A lo exige
  curp       String  @unique
  clabe      String
  bankName   String
  phone      String
  // Cuándo se CAMBIÓ la CLABE por última vez (null = la del onboarding). Cambiar
  // la cuenta de destino es el vector clásico para desviar pagos si alguien
  // toma la sesión del profesor: la hoja de pago del admin avisa cuando la CLABE
  // es reciente, y el cambio manda un correo al titular.
  clabeUpdatedAt DateTime?

  // Carril de pago
  paymentRail    TeacherPaymentRail @default(ASIMILADOS) // Carril B = default
  csfDocumentUrl String? // Constancia de Situación Fiscal (solo Carril A)

  // Disponibilidad semanal: [{ weekday: 0-6, startMinute, endMinute }] en hora
  // de México. Validada en el borde (src/lib/teachers/availability.ts).
  availability Json @default("[]")

  // Nivel — SOLO por mérito automático (src/lib/teachers/level-engine.ts).
  // Nadie lo asigna ni lo elige, y nunca baja.
  level           TeacherLevel @default(INICIAL)
  levelPromotedAt DateTime?

  // Estado
  status        TeacherStatus @default(PENDING_REVIEW)
  onboardedAt   DateTime?
  suspendedAt   DateTime?
  suspendReason String?

  // Aceptaciones digitales, con marca de tiempo y versión del texto
  contractAcceptedAt        DateTime?
  contractVersion           String?
  ndaAcceptedAt             DateTime?
  recordingPolicyAcceptedAt DateTime?

  // Métricas (alimentan el nivel automático)
  totalClassesGiven Int   @default(0)
  averageRating     Float @default(0)
  ratingCount       Int   @default(0)
  cancellationRate  Float @default(0) // porcentaje 0-100
  monthsActive      Int   @default(0)

  subjects TeacherSubject[]
  classes  ClassSession[]
  payouts  TeacherPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([level])
  @@index([paymentRail])
  @@map("teachers")
}

model TeacherSubject {
  id         String  @id @default(cuid())
  teacherId  String
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectKey String // clave del catálogo (src/lib/teachers/tariff.ts → BASE_RATES)
  // Instantánea de la tarifa base al elegir la materia, para auditoría. La
  // tarifa que se cobra SIEMPRE sale de `BASE_RATES` (tabulador), nunca de esta
  // columna: si el profesor pudiera editarla, fijaría su propio precio.
  baseRate   Int // centavos

  @@unique([teacherId, subjectKey])
  @@index([subjectKey])
  @@map("teacher_subjects")
}

model ClassSession {
  id               String      @id @default(cuid())
  teacherId        String
  teacher          Teacher     @relation(fields: [teacherId], references: [id])
  studentProfileId String
  studentProfile   UserProfile @relation("StudentClasses", fields: [studentProfileId], references: [id])

  // Detalle de la clase
  subjectKey      String
  scheduledAt     DateTime
  durationMinutes Int // 50 o 80

  // Tarifa calculada AL RESERVAR (las clases ya reservadas no cambian si el
  // profesor sube de nivel después). Los multiplicadores son INTERNOS: nunca
  // viajan al cliente.
  baseTariffCents    Int
  levelMultiplier    Float
  durationMultiplier Float
  advanceMultiplier  Float
  scheduleMultiplier Float
  demandMultiplier   Float
  finalTariffCents   Int // con tope duro 1.5×

  // Comisión (25%) y parte del profesor (75%), calculadas sobre lo RETENIDO
  commissionCents Int
  teacherPayCents Int

  // Pago del alumno
  stripePaymentId         String? // PaymentIntent
  stripeCheckoutSessionId String?   @unique // cuando se paga por Checkout hospedado
  paidAt                  DateTime?
  // Lo que se le DEBE devolver al alumno (lo fija la política de cancelación al
  // cancelar) y lo que YA se le devolvió en Stripe. Separarlos permite que un
  // job reintente un reembolso que falló sin volver a decidir la política:
  // deuda pendiente = refundDueCents − refundedCents.
  refundDueCents          Int       @default(0)
  refundedCents           Int       @default(0)
  stripeRefundId          String?

  // Estado
  status             ClassStatus  @default(PENDING_PAYMENT)
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?

  // Ciclo de vida (confirmación del profesor y enlace de la clase)
  confirmationRequestedAt DateTime?
  confirmedAt             DateTime?
  adminAlertedAt          DateTime?
  meetingLinkSentAt       DateTime?

  // Calificación
  studentRating   Int? // 1-5
  studentFeedback String?
  ratedAt         DateTime?

  // Disputa: el alumno reporta un problema de una clase marcada como impartida
  // (o discute un no-show). La clase pasa a DISPUTED y un admin la resuelve; el
  // pago al profesor NO se libera mientras esté en disputa.
  disputeReason String?
  disputedAt    DateTime?

  // Aula. La grabación exige consentimiento (tutor si es menor); sin él NO se
  // graba. `recordingConsent` es la instantánea al reservar.
  meetingUrl         String?
  meetingEventId     String?
  recordingConsent   Boolean   @default(false)
  recordingUrl       String?
  recordingExpiresAt DateTime?

  payoutId String?
  payout   TeacherPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, scheduledAt])
  @@index([studentProfileId, status])
  @@index([status])
  @@index([scheduledAt])
  @@index([payoutId])
  @@map("class_sessions")
}

// Liquidación semanal por clase impartida. ⚠️ Solo el MODELO está en esta fase:
// el motor (cálculo → aprobación → hoja de pago → transferido) queda BLOQUEADO
// hasta que Ángel confirme que el contador ya validó el proceso operativo.
model TeacherPayout {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  grossCents     Int // total antes de retenciones
  retentionCents Int // reserva de desempeño (15%)
  netCents       Int // monto a transferir

  status        PayoutStatus @default(PENDING)
  approvedAt    DateTime?
  approvedBy    String? // userProfileId del admin que aprobó
  transferredAt DateTime?
  speiReference String? // clave de rastreo SPEI
  failedAt      DateTime?
  failReason    String?

  classes ClassSession[]

  // Reserva de desempeño: se libera 30 días naturales después si no hay
  // incidencias. Nunca se omite (spec §13).
  retentionReleasedAt DateTime?
  retentionStatus     RetentionStatus @default(HELD)

  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([status])
  @@index([periodEnd])
  @@map("teacher_payouts")
}

// ──────────────── PROGRAMA DE REFERIDOS (Bloque 3) ────────────────
//
// Tres niveles, separados por CÓMO se paga (ESPECIFICACION_QR_COMISIONES §2).
// Solo el NIVEL 1 (Referido, en CRÉDITO) está activo. Los campos de Embajador y
// Aliado existen porque el modelo de la spec (§3.1) los pide, pero NINGÚN
// código los escribe: el efectivo espera al contador, igual que el marketplace.
//
//   · Un código REFERIDO se genera solo, para cualquier alumno o tutor.
//   · La venta atribuida nace PENDING y entra a un periodo antifraude de 7
//     días; pasado el periodo, sin reembolso ni marca, se ACREDITA y se abre un
//     LOTE de crédito de $150 que vence a los 12 meses.
//   · El crédito NO se canjea por efectivo: solo baja el precio de la siguiente
//     compra, y jamás por debajo del piso de $500 netos (commission.ts).
//
// 🔒 Las cuatro tablas son de SOLO SERVIDOR (RLS sin política + REVOKE en la
// migración 0023): la app las lee y escribe únicamente por Prisma.

enum ReferralType {
  REFERIDO // Nivel 1 — crédito, cualquier usuario
  EMBAJADOR // Nivel 2 — efectivo, adultos con RFC. ⛔ Inactivo (espera al contador)
  ALIADO // Nivel 3 — B2B. ⛔ Inactivo (fase 2)
}

enum CommissionType {
  CREDIT
  CASH // ⛔ Sin uso hasta el Nivel 2
}

enum CommissionStatus {
  PENDING // Venta completada; en periodo antifraude (7 días) o retenida por una marca
  ACCRUED // Acreditada: el lote de crédito existe
  PAID // Efectivo transferido (solo CASH)
  REVERSED // Revertida: reembolso, fraude o autocompra
}

enum CreditRedemptionStatus {
  RESERVED // El checkout tiene el crédito apartado
  CONSUMED // El pago se confirmó por webhook: el crédito se gastó
  RELEASED // El pago no ocurrió: el crédito volvió a sus lotes
}

model ReferralCode {
  id   String @id @default(cuid())
  code String @unique // MAYÚSCULAS, siempre

  // La spec (§3.1) escribe `userId` con relación a `User`; en este proyecto la
  // cuenta es `UserProfile` (su `userId` es el UID de Supabase Auth). Nulable
  // porque un Aliado B2B no es un usuario registrado.
  userProfileId String?
  userProfile   UserProfile? @relation("ReferralCodeOwner", fields: [userProfileId], references: [id], onDelete: SetNull)

  type      ReferralType @default(REFERIDO)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  // Suspensión (admin): detiene la atribución NUEVA y RETIENE —no cancela— las
  // comisiones pendientes hasta que el admin decida.
  suspendedAt     DateTime?
  suspendedReason String?

  // Solo Embajador/Aliado. ⛔ Ningún código los escribe en esta fase.
  holderName  String?
  holderRfc   String?
  holderClabe String?
  paymentRail TeacherPaymentRail? // la spec lo llama `PaymentRail`; es el mismo par de valores que el del profesor

  sales         ReferralSale[]
  referredUsers UserProfile[]  @relation("ReferredByCode")

  // Una persona tiene UN código por tipo. Cierra la carrera de dos clics que
  // generan el código a la vez (el segundo INSERT viola el único y se lee el ya
  // creado). Los NULL (Aliados) no colisionan entre sí en Postgres.
  @@unique([userProfileId, type])
  @@index([userProfileId])
  @@map("referral_codes")
}

model ReferralSale {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])

  // El id de la compra: `Subscription.id`. ÚNICO: una compra produce a lo sumo
  // UNA venta atribuida, así que reprocesar el webhook o correr el respaldo
  // diario dos veces jamás duplica una comisión.
  purchaseId String @unique

  // Sin clave foránea, igual que `AdminAuditLog.targetUserProfileId`: es un
  // registro de lo que pasó y debe sobrevivir aunque la cuenta se elimine.
  buyerProfileId String

  saleAmount       Int // lo que el comprador PAGÓ, en centavos (ya con su crédito descontado)
  commissionAmount Int // centavos ($150 = 15000). 0 en una venta bloqueada
  commissionType   CommissionType
  status           CommissionStatus @default(PENDING)

  createdAt     DateTime  @default(now())
  accrueAfter   DateTime // fin del periodo antifraude (cobro + 7 días)
  accruedAt     DateTime?
  paidAt        DateTime?
  reversedAt    DateTime?
  reverseReason String?

  // Antifraude. `fraudFlag` guarda las marcas separadas por coma. Una marca
  // BLANDA retiene la acreditación hasta que un admin la resuelve
  // (`fraudClearedAt` = falsa alarma); una DURA (autocompra) nace REVERSED.
  fraudFlag      String?
  fraudClearedAt DateTime?

  creditLot ReferralCreditLot?

  @@index([referralCodeId, createdAt])
  @@index([buyerProfileId])
  @@index([status, accrueAfter])
  @@index([fraudFlag])
  @@map("referral_sales")
}

// UN lote por venta acreditada. `remainingCents` baja al reservar crédito en un
// checkout y vuelve a subir si ese checkout se libera. El lote que vence lo
// hace por fecha: no hay job que lo borre.
model ReferralCreditLot {
  id String @id @default(cuid())

  userProfileId String
  userProfile   UserProfile @relation("ReferralCreditOwner", fields: [userProfileId], references: [id], onDelete: Cascade)

  saleId String       @unique
  sale   ReferralSale @relation(fields: [saleId], references: [id])

  amountCents    Int
  remainingCents Int
  accruedAt      DateTime
  expiresAt      DateTime // acreditación + 12 meses
  revokedAt      DateTime? // la venta se revirtió después de acreditarse
  createdAt      DateTime  @default(now())

  @@index([userProfileId, expiresAt])
  @@map("referral_credit_lots")
}

// El crédito apartado por UN checkout. `allocations` = [{ lotId, cents }], de
// dónde salió cada centavo, para poder devolverlo a su lote si el pago no
// ocurre. `subscriptionId` (sin clave foránea) lo une a la Subscription PENDING
// del mismo checkout: el webhook consume, o el fallo/expiración libera, por ahí.
model ReferralCreditRedemption {
  id String @id @default(cuid())

  userProfileId String
  userProfile   UserProfile @relation("ReferralCreditRedeemer", fields: [userProfileId], references: [id], onDelete: Cascade)

  subscriptionId String?                @unique
  amountCents    Int
  allocations    Json
  status         CreditRedemptionStatus @default(RESERVED)

  createdAt     DateTime  @default(now())
  consumedAt    DateTime?
  releasedAt    DateTime?
  releaseReason String?

  @@index([userProfileId, status])
  @@index([status, createdAt])
  @@map("referral_credit_redemptions")
}
