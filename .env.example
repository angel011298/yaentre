# App — origen público del sitio. Base de los links de verificación/
# recuperación de Supabase, del redirect de Stripe Checkout, Y de todos los
# `canonical`/`og:url`/`og:image` (metadataBase, G68). En producción DEBE ser
# `https://yaentre.com`. Si se deja sin definir, en producción el código cae a
# `https://yaentre.com` como red de seguridad; en desarrollo, a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO — verificación de propiedad del sitio (G68). Opcionales: el dueño puede
# verificar por DNS TXT en su lugar y dejar estas vacías. Si se ponen, Next
# emite la meta tag correspondiente en el <head> de todo el sitio. Ver
# docs/SEO.md para el procedimiento paso a paso.
#   Google Search Console → Configuración → "Etiqueta HTML": copiar SOLO el
#   valor del atributo content="..." (no la etiqueta completa).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#   Bing Webmaster Tools → "Opción 1: etiqueta meta": valor de content="...".
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/yaentre
DIRECT_URL=postgresql://user:password@host:5432/yaentre

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe Price IDs (F9, opcionales): 3 planes × 3 temporadas, PRD §9. Se
# generan y actualizan solos corriendo `pnpm stripe:setup-prices` con una
# STRIPE_SECRET_KEY real. Si se dejan sin configurar, el checkout calcula el
# mismo monto al vuelo (price_data) — no bloquean el flujo de pago.
STRIPE_PRICE_MENSUAL_EB=price_your-mensual-eb-id
STRIPE_PRICE_MENSUAL_REG=price_your-mensual-reg-id
STRIPE_PRICE_MENSUAL_LM=price_your-mensual-lm-id
STRIPE_PRICE_PASE_EB=price_your-pase-eb-id
STRIPE_PRICE_PASE_REG=price_your-pase-reg-id
STRIPE_PRICE_PASE_LM=price_your-pase-lm-id
STRIPE_PRICE_PREMIUM_EB=price_your-premium-eb-id
STRIPE_PRICE_PREMIUM_REG=price_your-premium-reg-id
STRIPE_PRICE_PREMIUM_LM=price_your-premium-lm-id

# Generación de contenido (G2): 100% vía sesiones de Claude Code, usando la
# suscripción existente — NUNCA la API de pago de Anthropic. No hay variable
# de entorno de API key para esto; ver scripts/content-insert-drafts.ts,
# scripts/content-blind-batch.ts y scripts/content-resolve-verification.ts.

# Email / Observabilidad
RESEND_API_KEY=your-resend-api-key

# Sentry (F20) — monitoreo de errores cliente+servidor+edge. Sin DSN real el
# SDK queda inerte (no lanza, no bloquea nada) — pendiente documentado en
# docs/ESTADO.md. ORG/PROJECT/AUTH_TOKEN son solo para subir sourcemaps
# legibles al build de producción; sin ellos el build compila igual.
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog (F20) — analítica de producto del embudo completo. Sin key real,
# `posthog-node`/`posthog-js` no lanzan (fallan en silencio) — mismo criterio
# que Sentry, pendiente documentado en docs/ESTADO.md.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rastreo de campañas de publicidad (F24) — Meta Pixel / TikTok Pixel. Solo
# se cargan en el navegador si el usuario aceptó cookies (F21) Y el ID aquí
# NO es un placeholder — sin key real, quedan inertes (mismo criterio que
# Sentry/PostHog arriba). 4 eventos: PageView (landing/precios),
# CompleteRegistration (registro), InitiateCheckout (inicio de pago),
# Purchase (compra confirmada, con valor y plan reales).
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id

# Feature flags
NEXT_PUBLIC_ENABLE_UAM=false
NEXT_PUBLIC_ENABLE_EXANI=false
NEXT_PUBLIC_ENABLE_MEDIA_SUPERIOR=false

# Cron
CRON_SECRET=your-cron-secret

# ── Suite E2E (F19) ──
# Cuenta con onboarding completo y contenido servible en su área. Conviene que
# tenga plan activo: el flujo feliz abre un simulacro en cada corrida y una
# cuenta gratuita solo tiene uno. Sin estas dos, los specs se auto-omiten.
E2E_EMAIL=
E2E_PASSWORD=
# Cuenta GRATUITA que YA terminó su simulacro gratis (escenario del paywall).
E2E_FREE_USED_EMAIL=
E2E_FREE_USED_PASSWORD=
# =1 activa el spec de registro real (consume cupo de correos de Supabase).
E2E_SIGNUP=
